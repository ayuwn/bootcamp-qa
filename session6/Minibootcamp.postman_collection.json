  },
  "item": [
    {
      "name": "POST BANK ACCOUNT DATA",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Bank account verification successful\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "\r",
              "    pm.expect(jsonData.status).to.eql(\"COMPLETED\");\r",
              "    pm.expect(jsonData.result.is_found).to.be.true;\r",
              "    pm.expect(jsonData.result.account_holder_name).to.eql(\"FIRA DIYANKA\");\r",
              "});\r",
              "\r",
              "let jsonData = pm.response.json();\r",
              "pm.environment.set(\"bank_request_id\", jsonData.id);\r",
              "console.log(\"Bank Request ID:\", pm.environment.get(\"bank_request_id\"));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "{{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n \"bank_account_number\": \"12345670\",\n \"bank_code\": \"BCA\",\n \"given_name\": \"FIRA DIYANKA\",\n \"surname\": \"FIRA DIYANKA\",\n \"reference_id\": \"testing123-456\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://api.iluma.ai/v1.1/identity/bank_account_data_requests",
          "protocol": "https",
          "host": [
            "api",
            "iluma",
            "ai"
          ],
          "path": [
            "v1.1",
            "identity",
            "bank_account_data_requests"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET BANK ACCOUNT DATA",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response body structure is valid\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "\r",
              "    pm.expect(jsonData.status).to.eql(\"COMPLETED\");\r",
              "    pm.expect(jsonData.id).to.exist;\r",
              "    pm.expect(jsonData.result).to.exist;\r",
              "    pm.expect(jsonData.result.is_found).to.be.true;\r",
              "    pm.expect(jsonData.result.account_holder_name).to.not.be.empty;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "{{token}}"
          }
        ],
        "url": {
          "raw": "https://api.iluma.ai/v1.1/identity/bank_account_data_requests/{{bank_request_id}}",
          "protocol": "https",
          "host": [
            "api",
            "iluma",
            "ai"
          ],
          "path": [
            "v1.1",
            "identity",
            "bank_account_data_requests",
            "{{bank_request_id}}"
          ]
        }
      },
      "response": []
    }
  ]
}